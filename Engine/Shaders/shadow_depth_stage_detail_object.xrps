#include "common.xrh"
#include "gbuffer.xrh"
#include "alpha_test.xrh"
#include "material.xrh"
///////////////////////////////////////////////////////////////////////////////////
struct Interpolators
{
    float4 HomogeniousPosition : POSITION;
    float3 Position : TEXCOORD0;
    float2 UV : TEXCOORD1;
};
///////////////////////////////////////////////////////////////////////////////////
float4 main(Interpolators Input) : COLOR0
{
    float Opacity = GetOpacity(Input.UV.xy);

    calc_alpha_test(Input.UV.xy, Opacity);

    return 1.0f;
}
///////////////////////////////////////////////////////////////////////////////////
