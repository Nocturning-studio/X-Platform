////////////////////////////////////////////////////////////////////////////
float hash(float n)
{
    return frac(sin(n) * 43758.5453123f);
}

float random(float income)
{
    return frac((sin(income) * 4698.0101255f) + (sin(income) * 29189.92918f) + (sin(income) * 8.327f));
}

float3 Hash3D_Temporal(float2 uv)
{
    float3 result = 0.0f;
    result.r = sin(random(uv.x * (timers.x + 250.0f) - uv.y * (timers.x + 2125.0f)));
    result.g = sin(random(uv.x * (timers.x + 80.0f) + uv.y * (timers.x + 1.0f)));
    result.b = sin(random(uv.x * (timers.x + 8.0f) - uv.y * (timers.x + 32.0f)));
    return result;
}
////////////////////////////////////////////////////////////////////////////
float2 Hash2D(float2 p)
{
    float3 p3 = frac(float3(p.xyx) * float3(.1031, .1030, .0973));
    p3 += dot(p3, p3.yzx + 33.33);
    return frac((p3.xx + p3.yz) * p3.zy);
}
////////////////////////////////////////////////////////////////////////////
float Hash1D(float3 p3)
{
    p3 = frac(p3 * .1031);
    p3 += dot(p3, p3.zyx + 31.32);
    return frac((p3.x + p3.y) * p3.z);
}
////////////////////////////////////////////////////////////////////////////
bool isHUD(float matID)
{
    return matID == HUD_MATERIAL;
}
////////////////////////////////////////////////////////////////////////////
float4 billinear_filter(sampler2D Sampler, float2 TexCoords)
{
    float4 result = 0.0f;
    
    result += tex2Dlod0(Sampler, TexCoords + screen_res.zw * float2(1.5f, -0.5f));
    result += tex2Dlod0(Sampler, TexCoords + screen_res.zw * float2(1.5f, 1.5f));
    result += tex2Dlod0(Sampler, TexCoords + screen_res.zw * float2(-0.5f, -0.5f));
    result += tex2Dlod0(Sampler, TexCoords + screen_res.zw * float2(-0.5f, 1.5f));
    
    return result * 0.25f;
}
////////////////////////////////////////////////////////////////////////////
float3x3 CalculateTBN(float3 Position, float3 Normal, float2 UV)
{
    // Get edge vectors of the pixel triangle
	float3 dp1 = ddx(Position.xyz);
	float3 dp2 = ddy(Position.xyz);
	
	float2 duv1 = ddx(UV.xy);
	float2 duv2 = ddy(UV.xy);

	float3 N = normalize(Normal);

    // Solve the linear system
	float3 dp2perp = cross(dp2, N);
	float3 dp1perp = cross(N, dp1);
	
	float3 T = normalize(dp2perp * duv1.x + dp1perp * duv2.x);
	float3 B = normalize(dp2perp * duv1.y + dp1perp * duv2.y);
	
	return float3x3( T.x, B.x, N.x,
                     T.y, B.y, N.y,
                     T.z, B.z, N.z );
}
//////////////////////////////////////////////////////////////////////////////////////////
float2 GetViewSpaceTexCoordsFromPosition(float3 ViewSpacePosition)
{
    return (ViewSpacePosition.xy / ViewSpacePosition.zz + pos_decompression_params.xy) / pos_decompression_params.zw / screen_res.xy;
}
//////////////////////////////////////////////////////////////////////////////////////////
bool is_in_range(float val, float min, float max)
{
    return val >= min && val <= max;
}
//////////////////////////////////////////////////////////////////////////////////////////	
bool is_in_quad(float2 p, float2 lt = float2(0, 0), float2 rb = float2(1, 1))
{
    return is_in_range(p.x, lt.x, rb.x) && is_in_range(p.y, lt.y, rb.y);
}
//////////////////////////////////////////////////////////////////////////////////////////
float4 proj_to_screen(float4 proj)
{
    float4 screen = proj;
    screen.x = (proj.x + proj.w);
    screen.y = (proj.w - proj.y);
    screen.xy *= 0.5;
    return screen;
}
//////////////////////////////////////////////////////////////////////////////////////////
float3x3 CalculateTBNFromNormal(float3 normal)
{
    float3 up = float3(0.0f, 0.0f, 1.0f);
    if (abs(normal.z) > 0.999f)
        up = float3(1.0f, 0.0f, 0.0f);
    
    float3 tangent = normalize(cross(up, normal));
    float3 bitangent = cross(normal, tangent);
    
    return float3x3(tangent, bitangent, normal);
}
////////////////////////////////////////////////////////////////////////////
#include "tonemapping.xrh"
#include "fog_helper.xrh"
////////////////////////////////////////////////////////////////////////////
float3 GetSkyCubeInterpolated(samplerCUBE s_environment_0, samplerCUBE s_environment_1, float3 cube_coords, float interpolator, float mip_level)
{
    float3 SkyCube0 = texCUBElod(s_environment_0, float4(cube_coords, mip_level)).rgb;
    SkyCube0 = sRgbToLinear(SkyCube0);
    float3 SkyCube1 = texCUBElod(s_environment_1, float4(cube_coords, mip_level)).rgb;
    SkyCube1 = sRgbToLinear(SkyCube1);
    float3 SkyCube = lerp(SkyCube0, SkyCube1, interpolator);
    return lerp(SkyCube, fog_params.rgb, saturate(GetFogDensity() * 2.0f));
}
