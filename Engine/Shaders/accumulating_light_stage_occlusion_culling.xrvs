#include "common.xrh"
///////////////////////////////////////////////////////////////////////////////////
struct Interpolators
{
	float4 HomogeniousPosition: POSITION;
};
///////////////////////////////////////////////////////////////////////////////////
Interpolators main(float4 Position: POSITION)
{
    Interpolators Output;
    Output.HomogeniousPosition = mul(m_WorldViewProject, Position);
    return Output;
}
