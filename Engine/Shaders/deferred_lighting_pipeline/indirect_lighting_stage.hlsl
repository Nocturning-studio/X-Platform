uniform sampler2D s_gbuffer_0;
////////////////////////////////////////////////////////////////////////////////
struct Interpolants
{
	float4 Position : POSITION;
	float2 TexCoords : TEXCOORD0;
};

float4 ps_main(Interpolants Input) : COLOR
{
	return tex2D(s_gbuffer_0, Input.TexCoords);
}
