uniform sampler2D s_frame;
////////////////////////////////////////////////////////////////////////////////
struct Interpolants
{
	float4 Position : POSITION;
	float2 TexCoords : TEXCOORD0;
};

float4 ps_main(Interpolants Input) : COLOR0
{
	return tex2D(s_frame, Input.TexCoords);
}
