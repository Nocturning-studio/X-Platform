//////////////////////////////////////////////////////////////////////////////////////////
#include "common.xrh"
//////////////////////////////////////////////////////////////////////////////////////////
float4 main(float2 TexCoords : TEXCOORD0) : COLOR
{
    float3 ImageColor = tex2D(s_base, TexCoords).rgb;
    
    ImageColor = sRgbToLinear(ImageColor);
    
    ImageColor = OETF_REC709(ImageColor);
    
    return float4(ImageColor, 1.0f);
}
//////////////////////////////////////////////////////////////////////////////////////////
