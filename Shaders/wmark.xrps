//////////////////////////////////////////////////////////////////////////////////////////
#include "common.xrh"
#include "gbuffer.xrh"
//////////////////////////////////////////////////////////////////////////////////////////
struct Interpolators
{
    float4 HomogeniousPosition : POSITION;
    float2 UV : TEXCOORD0;
    float3 Position : TEXCOORD1;
    float3 Color : COLOR0;
};
//////////////////////////////////////////////////////////////////////////////////////////
float4 main(Interpolators Input) : COLOR0
{
    float4 c = tex2D(s_base, Input.UV);
    c.rgb = sRgbToLinear(c.rgb);
    c.a = sRgbToLinear(c.a).x;
    return c;
}
//////////////////////////////////////////////////////////////////////////////////////////
