//////////////////////////////////////////////////////////////////////////////////////////
#include "common.xrh"
//////////////////////////////////////////////////////////////////////////////////////////
float4 main(float2 TexCoords : TEXCOORD0) : COLOR
{
    float2 DistortionMask = tex2D(s_distort, TexCoords).xy;
    float2 SampleOffset = (DistortionMask.xy - 0.5f) * def_distort;
    float3 ImageColor = tex2D(s_base, TexCoords + SampleOffset).rgb;

    return float4(ImageColor, 1.0f);
}
//////////////////////////////////////////////////////////////////////////////////////////
