#define ALPHA_TEST_THESHOLD 0.4f
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
#include "common.xrh"
#include "hashed_alpha.xrh"
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
void calc_alpha_test(float2 TexCoords, float Opacity)
{
#ifdef USE_HASHED_ALPHA_TEST
	calc_hashed_alpha_test(TexCoords, Opacity);
#else
	clip(Opacity - ALPHA_TEST_THESHOLD);
#endif
}
