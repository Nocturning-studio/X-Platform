////////////////////////////////////////////////////////////////////////////
uniform float additional_ambient;
////////////////////////////////////////////////////////////////////////////
struct AmbientOcclusion
{
    float RealTime;
    float Lightmap;
    float Baked;
    float Combined;
};

float GetAOWithFilter(float2 TexCoords)
{
    float ao = 0.0f;
    
    ao += tex2Dlod0(s_ao, TexCoords + screen_res.zw * float2(1.5f, -0.5f)).r;
    ao += tex2Dlod0(s_ao, TexCoords + screen_res.zw * float2(1.5f, 1.5f)).r;
    ao += tex2Dlod0(s_ao, TexCoords + screen_res.zw * float2(-0.5f, -0.5f)).r;
    ao += tex2Dlod0(s_ao, TexCoords + screen_res.zw * float2(-0.5f, 1.5f)).r;
    
    return ao * 0.25f;
}

AmbientOcclusion CalculateAmbientOcclusion(GBuffer GBuffer, float3 WorldSpaceNormal, float2 TexCoords, float3 ViewDirection)
{
    AmbientOcclusion ao;
    
    ao.RealTime = tex2Dlod0(s_ao, TexCoords).r;
    
    const float adjustBrightness = 6.0f;
    const float minAmbient = 0.016f;
    
    float LightmapRaw = saturate(GBuffer.AO);
    
    float nvFactor = saturate(additional_ambient * 10.0f); 
    
    float targetGamma = 2.2f;
    float LightmapCurve = safe_pow(LightmapRaw * adjustBrightness, targetGamma);
    
    float LightmapFinal = (LightmapCurve * AMBIENT_BRIGHTNESS) + minAmbient;
    
    float nvBoost = additional_ambient; // Сила подсветки
    
    LightmapFinal = max(LightmapFinal, nvBoost * ao.RealTime);
    
    ao.Lightmap = Reinhard(LightmapFinal);
    
    ao.Baked = GBuffer.BakedAO;
    
    ao.Combined = ao.RealTime * ao.Baked * ao.Lightmap;
    
    ao.Combined *= GBuffer.Cavity;

    return ao;
}
////////////////////////////////////////////////////////////////////////////
