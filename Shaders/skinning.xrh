struct v_model
{
    float4 P : POSITION; // (float,float,float,1)
    float3 N : NORMAL; // (nx,ny,nz)
    float3 T : TANGENT; // (nx,ny,nz)
    float3 B : BINORMAL; // (nx,ny,nz)
    float2 tc : TEXCOORD0; // (u,v)
};

struct v_model_skinned_0
{
    float4 P : POSITION; // (float,float,float,1) - quantized	// short4
    float3 N : NORMAL; // normal				// DWORD
    float3 T : TANGENT; // tangent				// DWORD
    float3 B : BINORMAL; // binormal				// DWORD
    float2 tc : TEXCOORD0; // (u,v)
};

struct v_model_skinned_1
{
    float4 P : POSITION;      // (xyz, 1)
    float3 N : NORMAL;
    float3 T : TANGENT;
    float3 B : BINORMAL;
    float2 tc : TEXCOORD0;
    uint  index : TEXCOORD1;   // индекс кости *3
};

struct v_model_skinned_2
{
    float4 P : POSITION;      // (xyz, weight)
    float3 N : NORMAL;
    float3 T : TANGENT;
    float3 B : BINORMAL;
    float2 tc : TEXCOORD0;
    int2 indices : TEXCOORD1;  // индексы костей *3
};

//////////////////////////////////////////////////////////////////////////////////////////
uniform float4 sbones_array[256 - 22];
//////////////////////////////////////////////////////////////////////////////////////////
float3 skinning_dir(float3 dir, float3 m0, float3 m1, float3 m2)
{
    float3 U = unpack_normal(dir);
    return float3(dot(m0, U), dot(m1, U), dot(m2, U));
}

float4 skinning_pos(float3 pos, float4 m0, float4 m1, float4 m2)
{
    float4 P = float4(pos.xyz, 1.f);
    return float4(dot(m0, P), dot(m1, P), dot(m2, P), 1);
}

v_model skinning_0(v_model_skinned_0 v)
{
    // skinning
    v_model o;
    o.P = float4(v.P.xyz, 1.f);
    o.N = unpack_normal(v.N);
    o.T = unpack_normal(v.T);
    o.B = unpack_normal(v.B);
    o.tc = v.tc.xy;
    return o;
}

v_model skinning_1(v_model_skinned_1 v)
{
    int mid = v.index;  // уже умножено на 3 на CPU
    float4 m0 = sbones_array[mid + 0];
    float4 m1 = sbones_array[mid + 1];
    float4 m2 = sbones_array[mid + 2];

    v_model o;
    float4 pos = float4(v.P.xyz, 1.0);
    o.P = float4(dot(m0, pos), dot(m1, pos), dot(m2, pos), 1.0);
    o.N.xyz = float3(dot(m0.xyz, v.N), dot(m1.xyz, v.N), dot(m2.xyz, v.N));
    o.T = float3(dot(m0.xyz, v.T), dot(m1.xyz, v.T), dot(m2.xyz, v.T));
    o.B = float3(dot(m0.xyz, v.B), dot(m1.xyz, v.B), dot(m2.xyz, v.B));
    o.tc = v.tc;
    return o;
}

v_model skinning_2(v_model_skinned_2 v)
{
    int id_0 = v.indices.x;
    int id_1 = v.indices.y;

    float4 m0_0 = sbones_array[id_0 + 0];
    float4 m1_0 = sbones_array[id_0 + 1];
    float4 m2_0 = sbones_array[id_0 + 2];
    float4 m0_1 = sbones_array[id_1 + 0];
    float4 m1_1 = sbones_array[id_1 + 1];
    float4 m2_1 = sbones_array[id_1 + 2];

    float w = v.P.w;
    float4 m0 = lerp(m0_0, m0_1, w);
    float4 m1 = lerp(m1_0, m1_1, w);
    float4 m2 = lerp(m2_0, m2_1, w);

    v_model o;
    float4 pos = float4(v.P.xyz, 1.0);
    o.P = float4(dot(m0, pos), dot(m1, pos), dot(m2, pos), 1.0);
    o.N.xyz = float3(dot(m0.xyz, v.N), dot(m1.xyz, v.N), dot(m2.xyz, v.N));
    o.T = float3(dot(m0.xyz, v.T), dot(m1.xyz, v.T), dot(m2.xyz, v.T));
    o.B = float3(dot(m0.xyz, v.B), dot(m1.xyz, v.B), dot(m2.xyz, v.B));
    o.tc = v.tc;
    return o;
}
