#include "common.xrh"
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
float Unpack_LightMap(float2 LightMapUV)
{
    return avg3(tex2D(s_hemi, LightMapUV).rgb);
}

float Unpack_LightMap_Sun(float2 LightMapUV)
{
    return tex2D(s_lmap, LightMapUV).a;
}

float Fix_AO(float LightMapAO)
{
    return LightMapAO;//saturate(LightMapAO * 2.0f * ao_brightness + 0.025f);
}
