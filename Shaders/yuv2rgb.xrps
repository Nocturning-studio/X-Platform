#include "common.xrh"

float4 main(float2 uv: TEXCOORD0): COLOR
{
	float3 YUV = tex2Dlod0(s_base, uv).rgb;

    float Y = YUV.x;
    float U = YUV.y;
    float V = YUV.z;

    float c = 1.16406f;
	float3 _Y = c * Y;
	float3 _U = float3(0.0f, -0.390625f, +2.01562f) * U;
	float3 _V = float3(+1.59765f, -0.8125f, 0) * V;
	float3 _S = float3(-0.86961f, +0.53076f, -1.0786f);
	
    return float4(_Y + _U + _V + _S, 1);
}
